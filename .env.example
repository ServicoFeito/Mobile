# --- App (Expo) — preenchido de fato no Plano 2 ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Toolchain de banco (dev na nuvem) ---
# ref do projeto servico-feito-dev (dashboard/project/<ref>)
SUPABASE_PROJECT_REF=
